# GEMINI_API_KEY: Required for the AI receipt scanner (server/routes/receipt.ts).
# Read server-side only - do NOT prefix this with VITE_, or Vite will inline
# it into the client bundle where anyone can extract it from the built app/APK.
# AI Studio may also inject this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Backend (server/) -------------------------------------------------
# These are consumed by the Express API in server/, not by AI Studio. Set
# them in your local .env and in your host's (e.g. Render) environment vars.

# MONGODB_URI: MongoDB Atlas (or local) connection string.
MONGODB_URI="mongodb://localhost:27017/tabby"

# JWT_SECRET: REQUIRED. Long random string used to sign session tokens.
# The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# CORS_ORIGINS: comma-separated list of frontend origins allowed to call this
# API (e.g. "https://tabby.example.app,capacitor://localhost"). Required in
# production - see server/index.ts.
CORS_ORIGINS=""

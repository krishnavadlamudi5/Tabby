# Copy to .env for local development. On Render, set these as environment
# variables. Never commit real values: .env* is git-ignored.
#
# Anything prefixed VITE_ is inlined into the web bundle and the APK, where
# anyone can read it. NEVER put a secret in a VITE_ variable.

# --- Server (Render) ---------------------------------------------------

# MongoDB Atlas (or local) connection string.
MONGODB_URI="mongodb://localhost:27017/tabby"

# REQUIRED. Long random string used to sign 30-day session tokens.
# The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs every user out.
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Google OAuth client ids accepted when verifying sign-in tokens. The web
# client id is also used by Android sign-in. Defaults to the project's web
# client id if unset; only set GOOGLE_ANDROID_CLIENT_ID if Android tokens
# are issued for a different audience.
GOOGLE_WEB_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""

# Optional, comma-separated. When set, only these Google accounts may use the
# personal-finance features (/api/finance). Shared expenses stay open.
ALLOWED_EMAILS=""

# Comma-separated frontend origins allowed to call the API, e.g. your Netlify
# URL. Required in production (the Android app is always allowed).
CORS_ORIGINS=""

# Optional. Requests per IP per 15 minutes across /api (default 300).
RATE_LIMIT_MAX=""

# Write the sample demo users/groups/expenses into the database on start.
# Local development only; keep false in production.
SEED_DEMO=false

# Optional. Enables the receipt scanner (server/routes/receipt.ts). Read
# server-side only.
GEMINI_API_KEY=""

# Used by server/services/notificationService.ts for email.
RESEND_API_KEY=""

# --- Personal finance (server only) ------------------------------------

# 32 random bytes, base64. Encrypts documents, email bodies and statement
# passwords. BACK IT UP OFFLINE: losing it means losing those files.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=""
DATA_ENCRYPTION_KEY_VERSION=1

# Gmail push (tools/apps-script). The same secret goes in the Apps Script's
# Script Properties. INGEST_OWNER_EMAIL = the Google account you sign in with.
INGEST_HMAC_SECRET=""
INGEST_OWNER_EMAIL=""

# Scheduled jobs: GitHub Actions (.github/workflows/finance-jobs.yml) sends
# this as a Bearer token; store the same value as repo secret TABBY_JOBS_SECRET.
JOBS_SECRET=""

# Alert emails via Resend (uses RESEND_API_KEY above). Defaults to the
# owner's sign-in email.
ALERT_EMAIL_TO=""
RESEND_FROM=""

# Alert on single payments at or above this many paise (default ₹25,000).
FINANCE_LARGE_DEBIT_PAISE=""

# Cloudflare R2 for encrypted documents (free 10 GB). Keep the bucket private.
# Without these, files go to local disk (FILE_STORE_DIR), which Render wipes.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
FILE_STORE_DIR=""

# Optional AI backup for reading policy documents the label reader can't
# (Cloudflare Workers AI, free daily allowance). Leave empty to never use AI.
# Only masked text is sent (no name, phone, email, PAN, Aadhaar, card numbers).
CF_ACCOUNT_ID=""
CF_AI_TOKEN=""
CF_AI_MODEL="@cf/meta/llama-3.1-8b-instruct"

# --- Web build (Netlify + GitHub Actions) ------------------------------

# API base URL baked into the web bundle, e.g. https://tabby-api-bpb4.onrender.com/api
# Leave unset locally: Vite proxies /api to http://localhost:5000.
VITE_API_URL=""

# Public Google OAuth web client id (not a secret).
VITE_GOOGLE_CLIENT_ID=""
